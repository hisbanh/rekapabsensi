# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourusername.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com

# Database Configuration (SQLite for PythonAnywhere)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@sipayaumi.com

# Teacher Attendance - Location Validation
# Coordinates for school location (Yogyakarta example)
# Update with actual school GPS coordinates
SCHOOL_LATITUDE=-7.7956
SCHOOL_LONGITUDE=110.3695
SCHOOL_RADIUS_METERS=150

# Teacher Photo Upload Settings
TEACHER_PHOTO_MAX_SIZE=5242880
TEACHER_PHOTO_ALLOWED_TYPES=jpg,jpeg,png

# Security Settings (Production)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False